--- /dev/null
+++ b/browser/src/session/native-chrome.ts
@@ -0,0 +1,22 @@
+/** Once a native host claims chrome, retain it while its surface route is live.
+ * Input-focus/control polling is not the lifetime of the native renderer. */
+export class NativeChrome {
+  private timer: ReturnType<typeof setTimeout> | null = null;
+  private enabled = false;
+  constructor(private nativeOnly: () => boolean, private changed: (enabled: boolean) => void) {}
+  renew() {
+    if (this.timer) clearTimeout(this.timer);
+    this.timer = null;
+    const enabled = this.nativeOnly();
+    if (enabled !== this.enabled) {
+      this.enabled = enabled;
+      this.changed(enabled);
+    }
+    // An expired/departed native route or a TUI reader restores browser chrome.
+    if (enabled) this.timer = setTimeout(() => this.renew(), 3000);
+  }
+  dispose() {
+    if (this.timer) clearTimeout(this.timer);
+    this.timer = null;
+  }
+}
diff --git a/browser/src/session/native-controls.ts b/browser/src/session/native-controls.ts
new file mode 100644
index 0000000..87ffd31
--- /dev/null
+++ b/browser/src/session/native-controls.ts
@@ -0,0 +1,95 @@
+import { randomUUID } from "node:crypto";
+import { z } from "zod";
+
+interface Page {
+  id: number;
+  enabled: boolean;
+  url: string;
+  title: string;
+  loading: boolean;
+  canGoBack: boolean;
+  canGoForward: boolean;
+}
+interface Host {
+  current(): Page | null;
+  back(): void;
+  forward(): void;
+  reload(): void;
+  navigate(text: string): void;
+}
+const identity = {
+  version: z.literal(1),
+  instance: z.string().uuid(),
+  pane: z.string().regex(/^%[0-9]+$/),
+  tab: z.number().int().positive().max(Number.MAX_SAFE_INTEGER),
+  revision: z.number().int().positive().max(Number.MAX_SAFE_INTEGER),
+};
+const command = z.discriminatedUnion("action", [
+  z.object({ ...identity, action: z.enum(["back", "forward", "reload", "stop"]) }).strict(),
+  z.object({ ...identity, action: z.literal("navigate"), text: z.string().min(1).max(16384)
+    .refine(value => value.trim().length > 0 && !/[\x00-\x1f\x7f]/.test(value)) }).strict(),
+]);
+const display = (value: string, max: number) => value.replace(/[\x00-\x1f\x7f]/g, "").slice(0, max);
+
+export class NativeControls {
+  private readonly instance = randomUUID();
+  private revision = 1;
+  private previous: string | null = null;
+  private disposed = false;
+  constructor(private readonly pane: string, private readonly host: Host) {
+    if (!/^%[0-9]+$/.test(pane)) throw new Error("invalid native browser pane");
+  }
+
+  identity() { return { instance: this.instance, pane: this.pane }; }
+
+  invalidate() {
+    this.revision++;
+    this.previous = null;
+  }
+
+  dispose() {
+    this.disposed = true;
+    this.invalidate();
+  }
+
+  snapshot() {
+    const page = this.disposed ? null : this.host.current();
+    if (!page || !Number.isSafeInteger(page.id) || page.id <= 0 ||
+        !Number.isSafeInteger(this.revision)) {
+      if (this.previous !== null) this.invalidate();
+      return null;
+    }
+    const state = {
+      tab: page.id, enabled: page.enabled,
+      url: display(page.url, 16384), title: display(page.title, 512),
+      loading: page.loading, canGoBack: page.canGoBack, canGoForward: page.canGoForward,
+    };
+    const signature = JSON.stringify(state);
+    if (this.previous !== null && this.previous !== signature) this.revision++;
+    this.previous = signature;
+    if (!Number.isSafeInteger(this.revision)) return null;
+    return { version: 1 as const, instance: this.instance, pane: this.pane,
+      revision: this.revision, ...state };
+  }
+
+  execute(input: unknown) {
+    const request = command.parse(input);
+    const state = this.snapshot();
+    if (!state || !state.enabled || request.instance !== state.instance ||
+        request.pane !== state.pane || request.tab !== state.tab ||
+        request.revision !== state.revision) throw new Error("browser target changed");
+    if ((request.action === "back" && !state.canGoBack) ||
+        (request.action === "forward" && !state.canGoForward) ||
+        (request.action === "reload" && state.loading) ||
+        (request.action === "stop" && !state.loading)) throw new Error("browser action unavailable");
+    this.invalidate();
+    switch (request.action) {
+      case "back": this.host.back(); break;
+      case "forward": this.host.forward(); break;
+      case "reload":
+      case "stop": this.host.reload(); break;
+      case "navigate": this.host.navigate(request.text); break;
+    }
+    return this.snapshot();
+  }
+}
diff --git a/browser/src/session/native-endpoint.ts b/browser/src/session/native-endpoint.ts
new file mode 100644
index 0000000..1468af1
--- /dev/null
+++ b/browser/src/session/native-endpoint.ts
@@ -0,0 +1,16 @@
+import { execFile } from "node:child_process";
+
+/** Publish only into the exact pane namespace supplied by tmux-ide open. */
+export function publishNativeEndpoint(env: NodeJS.ProcessEnv, socket: string,
+  identity: { instance: string; pane: string }) {
+  const binary = env.TMUX_IDE_BROWSER_TMUX;
+  const tmuxSocket = /^(.*),[0-9]+,[0-9]+$/.exec(env.TMUX ?? "")?.[1];
+  if (!binary?.startsWith("/") || !tmuxSocket?.startsWith("/") ||
+      !socket.startsWith("/") || socket.length > 1024 || identity.pane !== env.TMUX_PANE ||
+      !/^%[0-9]+$/.test(identity.pane)) return;
+  const value = JSON.stringify({version: 1, pid: process.pid, socket, ...identity});
+  execFile(binary, ["-S", tmuxSocket, "set-option", "-p", "-t", identity.pane,
+    "@tmux_ide_browser_control", value], {timeout: 2000, maxBuffer: 4096}, () => {});
+  // Do not clear a possibly replaced publisher on shutdown. The daemon checks PID
+  // liveness and the instance RPC refuses commands after its session is disposed.
+}

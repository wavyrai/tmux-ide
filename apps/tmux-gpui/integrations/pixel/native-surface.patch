@@ -0,0 +1,92 @@
+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const {NativeControls} = require('../dist/session/native-controls.js');
+function fixture() {
+  let page = {id: 1, enabled: true, url: 'https://example.test/', title: 'Example', loading: false, canGoBack: true, canGoForward: true};
+  const calls = [];
+  const controls = new NativeControls('%3', {
+    current: () => page,
+    back: () => calls.push('back'), forward: () => calls.push('forward'),
+    reload: () => calls.push(page.loading ? 'stop' : 'reload'),
+    navigate: text => calls.push(['navigate', text]),
+  });
+  const request = (action, extra = {}) => {
+    const {version, instance, pane, tab, revision} = controls.snapshot();
+    return {version, instance, pane, tab, revision, action, ...extra};
+  };
+  return {controls, calls, request, set: next => page = next, page};
+}
+test('routes each navigation action directly and rejects replay', () => {
+  const f = fixture();
+  for (const action of ['back','forward','reload']) {
+    const req = f.request(action); f.controls.execute(req);
+    assert.throws(() => f.controls.execute(req), /target changed/);
+  }
+  f.page.loading = true;
+  f.controls.execute(f.request('stop'));
+  f.controls.execute(f.request('navigate', {text: 'localhost:3000/a?q=x'}));
+  assert.deepEqual(f.calls, ['back','forward','reload','stop',['navigate','localhost:3000/a?q=x']]);
+});
+test('snapshot only advances for changed chrome, and bounds display strings', () => {
+  const f = fixture(); const first = f.controls.snapshot();
+  assert.deepEqual(f.controls.snapshot(), first);
+  f.page.title = 'new\n' + 'x'.repeat(2000); f.page.url = 'x'.repeat(20000);
+  const next = f.controls.snapshot();
+  assert.equal(next.revision, first.revision + 1);
+  assert.equal(next.title.length, 512); assert.equal(next.url.length, 16384);
+  assert.equal(next.title.includes('\n'), false);
+});
+test('tab activation, replacement and shutdown invalidate captured actions', () => {
+  const f = fixture(); let req = f.request('back');
+  f.page.id = 2; assert.throws(() => f.controls.execute(req), /target changed/);
+  req = f.request('back'); f.controls.invalidate();
+  assert.throws(() => f.controls.execute(req), /target changed/);
+  req = f.request('back'); f.controls.dispose();
+  assert.throws(() => f.controls.execute(req), /target changed/);
+  assert.equal(f.controls.snapshot(), null); assert.deepEqual(f.calls, []);
+});
+test('pane and instance identity never fall back to the current page', () => {
+  const f = fixture(); const other = fixture();
+  assert.throws(() => f.controls.execute({...f.request('back'), pane: '%4'}));
+  assert.throws(() => f.controls.execute(other.request('back')));
+  assert.deepEqual(f.calls, []);
+});
+test('loading transition cannot turn a delayed stop into reload', () => {
+  const f = fixture(); f.page.loading = true;
+  const req = f.request('stop'); f.page.loading = false;
+  assert.throws(() => f.controls.execute(req), /target changed/);
+  assert.throws(() => f.controls.execute(f.request('stop')), /unavailable/);
+  f.page.canGoBack = false;
+  assert.throws(() => f.controls.execute(f.request('back')), /unavailable/);
+  f.page.enabled = false;
+  assert.throws(() => f.controls.execute(f.request('forward')), /target changed/);
+  assert.deepEqual(f.calls, []);
+});
+test('malformed and oversized commands cause no browser operation', () => {
+  const f = fixture();
+  for (const req of [null, {}, {...f.request('back'), unexpected: true},
+    f.request('navigate', {text: ''}), f.request('navigate', {text: 'a\nb'}),
+    f.request('navigate', {text: 'x'.repeat(16385)}), f.request('navigate', {text: '   '}),
+    {...f.request('back'), revision: 1.5}, {...f.request('back'), action: 'execute-script'}]) {
+    assert.throws(() => f.controls.execute(req));
+  }
+  assert.deepEqual(f.calls, []);
+});
+test('native controls expose stable endpoint identity without command authority', () => {
+  const f = fixture();
+  const identity = f.controls.identity();
+  assert.equal(identity.pane, '%3');
+  assert.equal(identity.instance, f.controls.snapshot().instance);
+  assert.throws(() => f.controls.execute({...identity, action:'reload'}));
+  assert.deepEqual(f.calls, []);
+});
+test('native chrome uses the whole pane and fallback restores browser chrome', () => {
+  const {computeLayout} = require('../dist/session/layout.js');
+  const info = {width:800,height:600,cellHeight:20,basePx:16};
+  const native = computeLayout(info, 1, null, 0, true);
+  assert.equal(native.chrome.toolbarHeight, 0);
+  assert.deepEqual(native.chrome.page, {x:0,y:0,width:800,height:600});
+  const fallback = computeLayout(info, 1, null);
+  assert.ok(fallback.chrome.toolbarHeight > 0);
+  assert.ok(fallback.chrome.page.y > 0);
+});

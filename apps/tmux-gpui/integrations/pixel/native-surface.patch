+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { CellZoomFollower } = require('../dist/cell-zoom.js');
+const info = (rows, cellHeight) => ({ height: rows * cellHeight, cellHeight, basePx: cellHeight * 0.7575 });
+test('initial native PTY metric correction does not magnify the page', () => {
+  const zoom = new CellZoomFollower();
+  assert.equal(zoom.ratio(info(23, 32)), null);
+  assert.equal(zoom.ratio(info(24, 40)), null);
+  assert.equal(zoom.ratio(info(12, 40)), null);
+});
+test('font zoom follows inverse row changes within the same pixel viewport', () => {
+  const zoom = new CellZoomFollower();
+  zoom.ratio(info(30, 32));
+  assert.equal(zoom.ratio(info(24, 40)), 1.25);
+  assert.equal(zoom.ratio(info(30, 32)), 0.8);
+});

index 0000000..1910281
--- /dev/null
+++ b/browser/src/session/native-icon.ts
@@ -0,0 +1,64 @@
+import { execFile } from "node:child_process";
+import { nativeImage } from "electron";
+
+/** Only tmux-ide's launcher opts into pane metadata publication. */
+export class NativeIcon {
+  private last: string | null | undefined;
+  private pending: string | undefined;
+  private running = false;
+  private disposed = false;
+  private readonly binary: string | undefined;
+  private readonly pane: string | undefined;
+  private readonly socket: string | undefined;
+  constructor(env: NodeJS.ProcessEnv) {
+    this.binary = env.TMUX_IDE_BROWSER_TMUX;
+    this.pane = env.TMUX_PANE;
+    this.socket = /^(.*),[0-9]+,[0-9]+$/.exec(env.TMUX ?? "")?.[1];
+  }
+
+  update(file: string | null) {
+    if (this.disposed || this.last === file) return;
+    this.last = file;
+    let rgba = "";
+    try {
+      if (file) {
+        const icon = nativeImage.createFromPath(file);
+        if (!icon.isEmpty()) {
+          const bitmap = icon.resize({ width: 16, height: 16 }).toBitmap();
+          if (bitmap.length === 1024) {
+            // Electron's native bitmap is premultiplied BGRA on macOS.
+            // The wire pixels are straight-alpha RGBA, like decoded PNG pixels.
+            for (let i = 0; i < bitmap.length; i += 4) {
+              const blue = bitmap[i]!;
+              const alpha = bitmap[i + 3]!;
+              const straight = (value: number) => alpha ? Math.min(255, Math.round(value * 255 / alpha)) : 0;
+              bitmap[i] = straight(bitmap[i + 2]!);
+              bitmap[i + 1] = straight(bitmap[i + 1]!);
+              bitmap[i + 2] = straight(blue);
+            }
+            rgba = bitmap.toString("hex");
+          }
+        }
+      }
+    } catch { /* A missing or unreadable favicon retains the browser fallback. */ }
+    this.pending = `${process.pid}:${rgba}`;
+    this.flush();
+  }
+  dispose() {
+    this.disposed = true;
+    this.pending = "";
+    this.flush();
+  }
+  private flush() {
+    if (this.running || this.pending === undefined || !this.binary?.startsWith("/") ||
+        !this.socket?.startsWith("/") || !/^%[0-9]+$/.test(this.pane ?? "")) return;
+    const value = this.pending;
+    this.pending = undefined;
+    this.running = true;
+    execFile(this.binary, ["-S", this.socket, "set-option", "-p", "-t", this.pane!,
+      "@tmux_ide_browser_icon", value], { timeout: 2000, maxBuffer: 4096 }, () => {
+        this.running = false;
+        this.flush();
+      });
+  }
+}

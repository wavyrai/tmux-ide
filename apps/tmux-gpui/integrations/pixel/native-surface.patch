+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const {NativeChrome} = require('../dist/session/native-chrome.js');
+test('native chrome survives absent control polls, then restores on route loss', t => {
+  t.mock.timers.enable({apis: ['setTimeout']});
+  let native = true;
+  const changes = [];
+  const chrome = new NativeChrome(() => native, value => changes.push(value));
+  chrome.renew();
+  t.mock.timers.tick(3000);
+  t.mock.timers.tick(3000);
+  assert.deepEqual(changes, [true]);
+  native = false;
+  t.mock.timers.tick(3000);
+  assert.deepEqual(changes, [true, false]);
+  native = true;
+  t.mock.timers.tick(3000);
+  assert.deepEqual(changes, [true, false]); // Requires a new host handshake.
+  chrome.renew();
+  assert.deepEqual(changes, [true, false, true]);
+  chrome.dispose();
+  native = false;
+  t.mock.timers.tick(6000);
+  assert.deepEqual(changes, [true, false, true]);
+});
+test('a plain terminal never claims native chrome', t => {
+  t.mock.timers.enable({apis: ['setTimeout']});
+  const changes = [];
+  const chrome = new NativeChrome(() => false, value => changes.push(value));
+  chrome.renew();
+  t.mock.timers.tick(6000);
+  assert.deepEqual(changes, []);
+  chrome.dispose();
+});

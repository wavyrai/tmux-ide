diff --git a/pixel/engine/crates/pixel-core/src/tmux_surface.rs b/pixel/engine/crates/pixel-core/src/tmux_surface.rs
new file mode 100644
index 0000000..f4cb2cc
--- /dev/null
+++ b/pixel/engine/crates/pixel-core/src/tmux_surface.rs
@@ -0,0 +1,213 @@
+use crate::{canvas::Frame, terminal::SessionEnv};
+use herdr_client::{
+    tmux_daemon::{LocalConfigNamespace, LocalDaemon, NativeSurfaceLocation, TerminalSelection},
+    tmux_handoff::ServerScope,
+    tmux_stream::ViewerMode,
+};
+use std::{
+    path::PathBuf,
+    sync::Arc,
+    time::{Duration, Instant},
+};
+use tmux_native_surface_sdk::publisher::{Publisher, RgbaCanvas};
+
+pub(crate) const POLL: Duration = Duration::from_millis(16);
+struct ExplicitConfig {
+    record: PathBuf,
+    scope: ServerScope,
+    selection: TerminalSelection,
+}
+impl ExplicitConfig {
+    fn parse(raw: &str) -> Option<Self> {
+        if raw.len() > 16384 {
+            return None;
+        }
+        let value: serde_json::Value = serde_json::from_str(raw).ok()?;
+        let text = |key: &str| -> Option<String> {
+            let s = value.get(key)?.as_str()?;
+            (!s.is_empty() && s.len() <= 4096).then(|| s.to_owned())
+        };
+        let record = PathBuf::from(text("record")?);
+        if !record.is_absolute() {
+            return None;
+        }
+        let pane = text("pane")?;
+        Some(Self {
+            record,
+            scope: ServerScope {
+                server_id: text("serverId")?,
+                generation: text("generation")?,
+            },
+            selection: TerminalSelection {
+                workspace_name: text("workspaceName")?,
+                live_session_id: text("liveSessionId")?,
+                selected_pane: pane.clone(),
+                visible_panes: vec![pane],
+                mode: ViewerMode::ReadOnly,
+            },
+        })
+    }
+}
+
+enum Config {
+    Explicit(ExplicitConfig),
+    Inherited {
+        record: PathBuf,
+        location: NativeSurfaceLocation,
+    },
+}
+impl Config {
+    fn from_env(env: &SessionEnv) -> Option<Self> {
+        if let Some(raw) = env.var("TMUX_IDE_NATIVE_SURFACE") {
+            return ExplicitConfig::parse(&raw).map(Self::Explicit);
+        }
+        let location =
+            NativeSurfaceLocation::from_tmux(&env.var("TMUX")?, &env.var("TMUX_PANE")?).ok()?;
+        let cwd = PathBuf::from(env.var("PWD")?);
+        let namespace = LocalConfigNamespace::from_environment(env.vars_os(), cwd, None)?;
+        Some(Self::Inherited {
+            record: namespace.daemon_record()?,
+            location,
+        })
+    }
+    fn connect(&self) -> Result<Publisher, tmux_native_surface_sdk::publisher::Error> {
+        let record = match self {
+            Self::Explicit(c) => &c.record,
+            Self::Inherited { record, .. } => record,
+        };
+        let owner = Arc::new(LocalDaemon::discover(record)?);
+        match self {
+            Self::Explicit(c) => Publisher::connect(&owner, &c.scope, &c.selection),
+            Self::Inherited { location, .. } => {
+                let context = owner.native_surface_context(location)?;
+                Publisher::connect(&owner, &context.scope, &context.selection)
+            }
+        }
+    }
+}
+
+pub(crate) struct Native {
+    config: Config,
+    publisher: Option<Publisher>,
+    retry: Instant,
+    announced: (bool, bool),
+    warned: bool,
+}
+impl Native {
+    pub(crate) fn from_env(env: &SessionEnv) -> Option<Self> {
+        let config = Config::from_env(env)?;
+        Some(Self {
+            config,
+            publisher: None,
+            retry: Instant::now(),
+            announced: (false, true),
+            warned: false,
+        })
+    }
+    pub(crate) fn active(&self) -> bool {
+        self.publisher.as_ref().is_some_and(|p| p.receivers() > 0)
+    }
+    pub(crate) fn kitty_required(&self) -> bool {
+        self.publisher
+            .as_ref()
+            .is_none_or(Publisher::kitty_required)
+    }
+    fn failed(&mut self, error: impl std::fmt::Debug) {
+        self.publisher = None;
+        self.retry = Instant::now() + Duration::from_secs(2);
+        if !self.warned {
+            crate::logging::warn("tmux-native", format!("native surface unavailable ({error:?}); using Kitty"));
+            self.warned = true;
+        }
+    }
+    pub(crate) fn poll(&mut self) -> bool {
+        if self.publisher.is_none() && Instant::now() >= self.retry {
+            let result = self.config.connect();
+            match result {
+                Ok(publisher) => {
+                    self.publisher = Some(publisher);
+                    self.warned = false;
+                }
+                Err(error) => self.failed(error),
+            }
+        }
+        if let Some(Err(error)) = self.publisher.as_mut().map(Publisher::poll) {
+            self.failed(error);
+        }
+        let state = (self.active(), self.kitty_required());
+        let changed = state != self.announced;
+        self.announced = state;
+        changed
+    }
+    pub(crate) fn present(&mut self, frame: Frame<'_>, cols: u32, rows: u32) -> bool {
+        if !self.active() {
+            return false;
+        }
+        let Some(publisher) = &mut self.publisher else {
+            return false;
+        };
+        let canvas = frame.canvas;
+        if let Err(error) = publisher
+            .present_rgba(RgbaCanvas {
+                width: canvas.width as usize,
+                height: canvas.height as usize,
+                rows: rows as usize,
+                columns: cols as usize,
+                rgba: &canvas.pixels,
+                premultiplied: frame.premultiplied,
+            })
+        {
+            self.failed(error);
+            return false;
+        }
+        true
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn inherited_context_uses_the_launching_terminal_namespace() {
+        let mut values = std::collections::HashMap::from([
+            ("HOME".into(), "/tmp/native-context-home".into()),
+            ("PWD".into(), "/tmp/native-context-work".into()),
+            ("TMUX".into(), "/tmp/private-tmux.sock,123,0".into()),
+            ("TMUX_PANE".into(), "%0".into()),
+            ("TMUX_IDE_HOME".into(), "isolated".into()),
+            ("TMUX_IDE_RUNTIME_MODE".into(), "test".into()),
+            (
+                "TMUX_IDE_TMUX_SOCKET_PATH".into(),
+                "/tmp/private-tmux.sock".into(),
+            ),
+            ("TMUX_IDE_CLEANUP_TOKEN".into(), "owned-fixture".into()),
+        ]);
+        let env = SessionEnv::of_session(values.clone());
+        let Some(Config::Inherited { record, .. }) = Config::from_env(&env) else {
+            panic!("valid terminal namespace was rejected");
+        };
+        assert_eq!(
+            record,
+            PathBuf::from("/tmp/native-context-work/isolated/daemon.json")
+        );
+        values.remove("TMUX_IDE_CLEANUP_TOKEN");
+        assert!(Config::from_env(&SessionEnv::of_session(values.clone())).is_none());
+        values.insert("TMUX_IDE_CLEANUP_TOKEN".into(), "owned-fixture".into());
+        values.insert("TMUX_IDE_NATIVE_SURFACE".into(), "invalid".into());
+        assert!(Config::from_env(&SessionEnv::of_session(values)).is_none());
+    }
+    #[test]
+    fn absent_or_invalid_configuration_keeps_kitty() {
+        for raw in ["{}", "null", "invalid", r#"{"record":"relative"}"#] {
+            assert!(ExplicitConfig::parse(raw).is_none());
+        }
+        assert!(ExplicitConfig::parse(&"x".repeat(16385)).is_none());
+        assert!(Native::from_env(&SessionEnv::of_session(Default::default())).is_none());
+    }
+    #[test]
+    fn configuration_never_grants_input_authority() {
+        let config = ExplicitConfig::parse(r#"{"record":"/private/daemon.json","serverId":"server","generation":"generation","workspaceName":"workspace","liveSessionId":"session","pane":"pane.browser"}"#).unwrap();
+        assert_eq!(config.selection.mode, ViewerMode::ReadOnly);
+        assert_eq!(config.selection.visible_panes, ["pane.browser"]);
+    }
+}

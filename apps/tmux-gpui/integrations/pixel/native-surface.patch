+const assert = require("node:assert/strict");
+const { test } = require("node:test");
+const { fetchLatestRelease, upgradeCommand } = require("../dist/release.js");
+
+test("managed browser updates cannot fetch or execute an upstream installer", async () => {
+  const original = globalThis.fetch;
+  let requests = 0;
+  globalThis.fetch = async () => { requests++; throw new Error("network must not be used"); };
+  try {
+    assert.equal(upgradeCommand(), "tmux-ide update");
+    await assert.rejects(fetchLatestRelease("stable"), /managed by tmux-ide/);
+    await assert.rejects(fetchLatestRelease("nightly"), /managed by tmux-ide/);
+    assert.equal(requests, 0);
+  } finally { globalThis.fetch = original; }
+});

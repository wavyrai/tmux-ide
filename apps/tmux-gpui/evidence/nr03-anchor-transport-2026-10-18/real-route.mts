import {execFileSync,spawnSync} from 'node:child_process';import {mkdtempSync,rmSync,writeFileSync} from 'node:fs';import {join} from 'node:path';import {randomUUID} from 'node:crypto';import assert from 'node:assert/strict';import {Hono} from 'hono';
import {createNativeTmuxServerOwner} from '../../../packages/daemon/src/lib/tmux-server-owner.ts';import {TmuxServerOwners} from '../../../packages/daemon/src/lib/tmux-server-owners.ts';import {mountTmuxServerRoutes} from '../../../packages/daemon/src/command-center/tmux-servers.ts';
const root=mkdtempSync('/tmp/nr03-route-'),socket=join(root,'s'),exe=join(process.cwd(),'.tasks/tmux38-compat/tmux-3.8/tmux');const result:any={pass:false};let owners:any;
const run=(args:string[])=>execFileSync(exe,['-S',socket,'-f','/dev/null',...args],{encoding:'utf8',env:{...process.env,TMUX:''}}).trim();const wait=async(fn:()=>boolean)=>{const end=Date.now()+5000;while(!fn()){if(Date.now()>end)throw Error('deadline');await new Promise(r=>setTimeout(r,20));}};
try{
run(['new-session','-d','-s','shared','-n','original','/bin/sh']);run(['set-option','-w','-t','shared:0','@tmux_ide_window_id','win.shared']);run(['set-option','-p','-t','shared:0.0','@tmux_ide_pane_id','pane.shared']);
const initial=run(['display-message','-p','#{pid}\t#{start_time}']);const [pid,startTime]=initial.split('\t');const authority={executablePath:exe,socketSelector:{kind:'path' as const,path:socket}};
owners=new TmuxServerOwners({probe:async()=>({fingerprint:initial,authority,nativeServerIdentity:{pid,startTime},valid:()=>{try{return run(['display-message','-p','#{pid}\t#{start_time}'])===initial;}catch{return false;}}}),create:async(_r:any,scope:any)=>createNativeTmuxServerOwner({environmentId:randomUUID(),...scope,tmuxAuthority:authority,nativeServerIdentity:{pid,startTime},stateDirectory:join(root,'state'),webSocketUrl:'ws://127.0.0.1:1/v2/terminal/pane-streams/redeem'})});
const descriptor=await owners.register({label:'owned',selector:{kind:'path',path:socket}});const scope={serverId:descriptor.serverId,generation:descriptor.generation};const owner=owners.current(scope);const rows=await owner.catalog();const target=rows.find((r:any)=>r.sessionName==='shared');assert(target);
const workspace=owner.workspaceRegistry.list().find((w:any)=>w.sessionName==='shared').name;
const consumer=owner.sessionRuntimeRegistry.connect('shared','test','first');let seed:any;await consumer.subscribeReplica('pane.shared',(u:any)=>{seed=u;});
run(['send-keys','-t','shared:0.0',"i=0; while [ $i -lt 50 ]; do printf 'SAME\\n'; i=$((i+1)); done",'Enter']);await wait(()=>owner.sessionRuntimeRegistry.qualificationSnapshot().sessions[0].replicas['pane.shared'].revision>0);
const fresh=owner.sessionRuntimeRegistry.connect('shared','test','snapshot');await fresh.subscribeReplica('pane.shared',(u:any)=>{seed=u;});assert(seed.snapshot.history.length>1);
const proof={workspaceName:workspace,semanticPaneId:'pane.shared',generation:seed.generation,incarnation:seed.incarnation,revision:seed.revision,stateHash:seed.stateHash};
const app=new Hono();mountTmuxServerRoutes(app,{owners,ownerToken:'private'});const path=`/api/v1/tmux-servers/${scope.serverId}/${scope.generation}/history-anchor`;
const req=async(proof:any,operation:any)=>{const r=await app.request(path,{method:'POST',headers:{Authorization:'Bearer private','Content-Type':'application/json'},body:JSON.stringify({version:1,liveSessionId:target.liveSessionId,proof,operation})});assert.equal(r.status,200);return (await r.json()).result;};
const captured=await req(proof,{kind:'capture',historyIndex:1});assert.equal(captured.status,'captured');await consumer.close();await fresh.close();
run(['send-keys','-t','shared:0.0',"printf 'NEXT\\n'",'Enter']);await wait(()=>owner.sessionRuntimeRegistry.qualificationSnapshot().sessions[0].replicas['pane.shared'].revision>proof.revision);
const identity={workspaceName:workspace,semanticPaneId:proof.semanticPaneId,generation:proof.generation,incarnation:proof.incarnation};const resolved=await req(identity,{kind:'resolve',token:captured.token});assert.equal(resolved.status,'resolved');assert.equal(resolved.historyIndex,1);assert(resolved.proof.revision>proof.revision);
result.pass=true;result.historyRows=seed.snapshot.history.length;result.captureRevision=proof.revision;result.resolveRevision=resolved.proof.revision;result.exactIndex=resolved.historyIndex;
} catch(e){result.error=String(e);}finally{await owners?.dispose();spawnSync(exe,['-S',socket,'kill-server'],{env:{...process.env,TMUX:''},stdio:'ignore'});result.socketClosed=spawnSync(exe,['-S',socket,'list-sessions'],{env:{...process.env,TMUX:''},stdio:'ignore'}).status!==0;rmSync(root,{recursive:true,force:true});writeFileSync('.tasks/native-reliability-mission/nr03-anchor-transport/real-route.json',JSON.stringify(result,null,2));console.log(JSON.stringify(result));}

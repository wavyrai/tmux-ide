import {execFileSync,spawnSync} from 'node:child_process';import {mkdtempSync,mkdirSync,rmSync,writeFileSync,existsSync} from 'node:fs';import {join,resolve} from 'node:path';import {randomUUID} from 'node:crypto';import assert from 'node:assert/strict';import {Hono} from 'hono';
import {createNativeTmuxServerOwner} from '../../../packages/daemon/src/lib/tmux-server-owner.ts';import {TmuxServerOwners} from '../../../packages/daemon/src/lib/tmux-server-owners.ts';import {mountTmuxServerRoutes} from '../../../packages/daemon/src/command-center/tmux-servers.ts';
const root=mkdtempSync('/tmp/nr07-tool-'),socket=join(root,'s'),exe=resolve('.tasks/tmux38-compat/tmux-3.8/tmux');const result:any={passed:false};let owners:any;
process.env.HOME=root;process.env.PATH='/usr/bin:/bin';delete process.env.TMUX;delete process.env.TMUX_PANE;
const run=(args:string[])=>execFileSync(exe,['-S',socket,'-f','/dev/null',...args],{encoding:'utf8',timeout:5000}).trim();
try{
mkdirSync(join(root,'.tmux-ide'));const config=join(root,'.tmux-ide/workspace.yml'),missing=join(root,'absent-agent');assert(!existsSync(missing));writeFileSync(config,`version: 1\nharnesses:\n  owned-missing:\n    adapter: generic-pty\n    command: [${missing}]\n`);
run(['new-session','-d','-s','owned','-c',root,'/bin/sh']);const initial=run(['display-message','-p','#{pid}\t#{start_time}']);const [pid,startTime]=initial.split('\t');const before=run(['list-panes','-a','-F','#{pane_id}|#{pane_pid}']);
const authority={executablePath:exe,socketSelector:{kind:'path' as const,path:socket}};
owners=new TmuxServerOwners({probe:async()=>({fingerprint:initial,authority,nativeServerIdentity:{pid,startTime},valid:()=>{try{return run(['display-message','-p','#{pid}\t#{start_time}'])===initial;}catch{return false;}}}),create:async(_r:any,scope:any)=>createNativeTmuxServerOwner({environmentId:randomUUID(),...scope,tmuxAuthority:authority,nativeServerIdentity:{pid,startTime},stateDirectory:join(root,'state'),webSocketUrl:'ws://127.0.0.1:1/v2/terminal/pane-streams/redeem'})});
const descriptor=await owners.register({label:'owned',selector:{kind:'path',path:socket}}),scope={serverId:descriptor.serverId,generation:descriptor.generation};const owner=owners.current(scope);const target=(await owner.catalog()).find((r:any)=>r.sessionName==='owned');assert(target);const w=owner.workspaceRegistry.list().find((r:any)=>r.sessionName==='owned');assert(w);owner.workspaceRegistry.remove(w.name);owner.workspaceRegistry.add({name:w.name,sessionName:'owned',projectDir:root,configKind:'workspace',configPath:config,hasWorkspaceConfig:true});
const originalCreate=owner.createSessionPane.bind(owner);owner.createSessionPane=async(...args:any[])=>{try{return await originalCreate(...args);}catch(error){result.ownerError={message:String(error),context:(error as any).context,cause:String((error as any).cause),stack:(error as any).stack};throw error;}};const app=new Hono();mountTmuxServerRoutes(app,{owners,ownerToken:'fixture'});const send=async(kind:string)=>{const response=await app.request(`/api/v1/tmux-servers/${scope.serverId}/${scope.generation}/panes/create?liveSessionId=${target.liveSessionId}`,{method:'POST',headers:{Authorization:'Bearer fixture','Content-Type':'application/json'},body:JSON.stringify({operationId:randomUUID(),expectedDaemonInstanceId:scope.generation,intent:{workspaceName:w.name,kind,placement:{kind:'window'},...(kind==='agent'?{harnessProfileId:'owned-missing',role:'implementer'}:{})}})});return{status:response.status,body:await response.json()};};
result.refusal=await send('agent');assert.equal(result.refusal.status,409);assert.deepEqual(result.refusal.body,{error:{code:'harness_unavailable'}});assert.equal(run(['list-panes','-a','-F','#{pane_id}|#{pane_pid}']),before);result.noPaneCreated=true;result.shell=await send('terminal');assert.equal(result.shell.status,200);assert.equal(result.shell.body.outcome,'created');result.passed=true;
}catch(e){result.error=String(e);}finally{await owners?.dispose();spawnSync(exe,['-S',socket,'kill-server'],{stdio:'ignore'});result.socketClosed=spawnSync(exe,['-S',socket,'list-sessions'],{stdio:'ignore'}).status!==0;rmSync(root,{recursive:true,force:true});writeFileSync('.tasks/native-reliability-mission/nr07-missing-agent/real-owner.json',JSON.stringify(result,null,2));console.log(JSON.stringify(result));if(!result.passed||!result.socketClosed)process.exitCode=1;}

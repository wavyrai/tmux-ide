@@ -0,0 +1,52 @@
+//! Temporary opt-in diagnostic. No input bytes or terminal contents are recorded.
+use super::SnapshotView;
+use std::{
+    io::Write,
+    sync::{OnceLock, atomic::{AtomicUsize, Ordering}},
+    time::Instant,
+};
+
+static ENABLED: OnceLock<bool> = OnceLock::new();
+static START: OnceLock<Instant> = OnceLock::new();
+static EVENTS: AtomicUsize = AtomicUsize::new(0);
+
+impl SnapshotView {
+    pub(super) fn trace_input_gate(
+        &self,
+        event: &'static str,
+        target: Option<&str>,
+        decision: Option<&'static str>,
+    ) {
+        if !*ENABLED.get_or_init(|| std::env::var("TMUX_GPUI_QA_INPUT_GATE").as_deref() == Ok("1")) {
+            return;
+        }
+        let started = START.get_or_init(Instant::now);
+        let Ok(index) = EVENTS.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| {
+            (n < 128).then_some(n + 1)
+        }) else {
+            return;
+        };
+        let record = serde_json::json!({
+            "event": event,
+            "sequence": index + 1,
+            "elapsed_us": started.elapsed().as_micros(),
+            "request": self.browser_request,
+            "state_request": self.browser_state.request,
+            "presence_active": self.presence.active(),
+            "presence_ready": self.presence.ready(),
+            "input_ready": self.browser_state.input_ready,
+            "terminal_ready": self.terminal_input_ready(),
+            "frame": self.frame.is_some(),
+            "painted": super::hit_regions::is_painted(self.frame.as_ref(), self.painted_frame.as_ref()),
+            "latch": self.input_interrupted,
+            "selected_pane": self.browser_state.selected_pane.as_deref(),
+            "target_pane": target,
+            "decision": decision,
+            "modal": self.picker.is_some() || self.pane_actions.is_some() || self.new_session.is_some(),
+            "divider": self.divider.is_some(),
+            "selection": self.selection.is_some(),
+        });
+        // Best-effort diagnostic output only; write errors must not change input handling.
+        let _ = writeln!(std::io::stderr(), "TMUX_GPUI_INPUT_GATE {record}");
+    }
+}

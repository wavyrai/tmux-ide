// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AppWindowCanvas > renders terminal content under canonical window identity and durable geometry 1`] = `"<div class="app-window-canvas" role="region" aria-label="Terminal canvas" aria-keyshortcuts="+ - 0 F ArrowLeft ArrowRight ArrowUp ArrowDown" tabindex="0" data-viewport-persistence="runtime-only" data-tmi-runtime-style="tmi-1" data-window-revision="3" data-window-count="1" data-focused-window-id="window.lead" data-viewport-x="0" data-viewport-y="0" data-viewport-scale="1.000" data-space-key="false"><div class="app-window-canvas__scene" data-tmi-runtime-style="tmi-2"><article class="app-window-card" data-tmi-runtime-style="tmi-3" data-window-id="window.lead" data-terminal-source-id="terminal.lead" data-placement="docked" data-selected="true" data-active="true" data-maximized="false" data-transient-geometry="false"><section class="web-pane-frame" aria-label="docked pane, running status, running agent, application focus, terminal input owner, selected for layout editing" aria-busy="false" aria-disabled="false" data-pane-id="window.lead" data-pane-role="terminal" data-structure="docked" data-border-role="focused" data-border-strength="decisive" data-focused="true" data-terminal-input-owner="true" data-layout-selected="true" data-attention="false" data-busy="false" data-disabled="false" data-window-active="true"><header class="web-pane-frame__header" data-surface="headerActive" data-agent-activity="running" data-attention="none"><button class="web-pane-frame__grip" type="button" aria-label="Move terminal pane" aria-disabled="false" title="Move pane"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 1.75v12.5M1.75 8h12.5"></path><path d="m5.75 4.25 2.25-2.5 2.25 2.5"></path><path d="m5.75 11.75 2.25 2.5 2.25-2.5"></path><path d="m4.25 5.75-2.5 2.25 2.5 2.25"></path><path d="m11.75 5.75 2.5 2.25-2.5 2.25"></path></svg></button><div class="web-pane-frame__identity"><span class="web-pane-frame__role-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3.25h12v9.5H2Z"></path><path d="m4.25 6 2 2-2 2"></path><path d="M8.25 10.25h3.5"></path></svg></span><span class="web-pane-frame__title-group"><strong class="web-pane-frame__title" title="Lead terminal">Lead terminal</strong><small class="web-pane-frame__subtitle" title="Codex">Codex</small></span></div><span class="web-pane-frame__status" role="status" aria-label="Terminal is running" title="Terminal is running" data-item-kind="status" data-item-id="window.lead.status" data-chip-kind="domain" data-tone="info" data-busy="true"><i aria-hidden="true"></i><span>Running</span></span><div class="web-pane-frame__actions" role="toolbar" aria-label="Pane controls"><button class="web-pane-frame__action" type="button" aria-label="Float this window on the canvas" aria-disabled="false" aria-busy="false" title="Float this window on the canvas" data-action-id="app-window-placement" data-command-id="workspace.window.float" data-state="base" data-active="false"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 5h8v7.5h-8Z"></path><path d="M2.5 10V3.5H10"></path><path d="m9 3.5 3.5 0V7"></path></svg><span class="web-pane-frame__action-label">Float</span></button><button class="web-pane-frame__action" type="button" aria-label="Float this window before maximizing" aria-disabled="true" aria-busy="false" aria-pressed="false" disabled="" title="Float this window before maximizing" data-action-id="app-window-maximize" data-command-id="workspace.window.maximize.toggle" data-state="disabled" data-active="false"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3h10v10H3Z"></path></svg><span class="web-pane-frame__action-label">Maximize</span></button><button class="web-pane-frame__action" type="button" aria-label="Closing app windows is not supported by the AppWindow command contract" aria-disabled="true" aria-busy="false" disabled="" title="Closing app windows is not supported by the AppWindow command contract" data-action-id="app-window-close" data-command-id="workspace.window.close" data-state="disabled" data-active="false"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3.5 3.5 9 9"></path><path d="m12.5 3.5-9 9"></path></svg><span class="web-pane-frame__action-label">Close</span></button></div></header><div class="web-pane-frame__body" data-body-sentinel="stable" id="pane-frame-body-window.lead" data-pane-body="window.lead" aria-label="terminal pane content"><div class="agent-pane__body" data-focus-zone="terminal"><div class="terminal-surface" data-phase="unavailable" data-focused="true" data-reduced-motion="false" data-preserves-frame="false"><div class="terminal-surface__viewport" aria-label="Lead terminal terminal"></div><div class="terminal-surface__state" aria-live="polite" role="status"><i aria-hidden="true"></i><strong>Native terminal unavailable</strong><span>The verified desktop terminal transport is not present in this build.</span></div></div></div></div></section></article></div><nav class="canvas-controls" aria-label="Canvas view controls"><button type="button" aria-label="Zoom out" title="Zoom out (-)"><svg class="canvas-controls__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-icon="zoom-out"><path d="M3 8h10"></path></svg></button><output aria-label="Canvas zoom 100 percent">100%</output><button type="button" aria-label="Zoom in" title="Zoom in (+)"><svg class="canvas-controls__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-icon="zoom-in"><path d="M8 3v10M3 8h10"></path></svg></button><i aria-hidden="true"></i><button type="button" aria-label="Fit windows" title="Fit windows (F)"><svg class="canvas-controls__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-icon="fit"><path d="M6 3H3v3M10 3h3v3M13 10v3h-3M6 13H3v-3"></path></svg></button><button type="button" aria-label="Reset view" title="Reset view (0)"><svg class="canvas-controls__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-icon="reset"><path d="M13 5.5V2.75l-1.5 1.5A5.25 5.25 0 1 0 13 10M13 2.75h-2.75"></path></svg></button></nav></div>"`;

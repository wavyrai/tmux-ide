// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AppWindowCanvas > renders terminal content under canonical window identity and durable geometry 1`] = `"<div class="app-window-canvas" data-window-revision="3" data-window-count="1" data-focused-window-id="window.lead"><article class="app-window-card" data-tmi-runtime-style="tmi-1" data-window-id="window.lead" data-terminal-source-id="terminal.lead" data-placement="docked" data-selected="true" data-active="true"><section class="web-pane-frame" aria-label="docked pane, running status, running agent, application focus, terminal input owner, selected for layout editing" aria-busy="false" aria-disabled="false" data-pane-id="window.lead" data-pane-role="terminal" data-structure="docked" data-border-role="focused" data-border-strength="decisive" data-focused="true" data-terminal-input-owner="true" data-layout-selected="true" data-attention="false" data-busy="false" data-disabled="false" data-window-active="true"><header class="web-pane-frame__header" data-surface="headerActive" data-agent-activity="running" data-attention="none"><button class="web-pane-frame__grip" type="button" aria-label="Move terminal pane" aria-disabled="true" disabled="" title="Pane movement unavailable"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 1.75v12.5M1.75 8h12.5"></path><path d="m5.75 4.25 2.25-2.5 2.25 2.5"></path><path d="m5.75 11.75 2.25 2.5 2.25-2.5"></path><path d="m4.25 5.75-2.5 2.25 2.5 2.25"></path><path d="m11.75 5.75 2.5 2.25-2.5 2.25"></path></svg></button><div class="web-pane-frame__identity"><span class="web-pane-frame__role-icon" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3.25h12v9.5H2Z"></path><path d="m4.25 6 2 2-2 2"></path><path d="M8.25 10.25h3.5"></path></svg></span><span class="web-pane-frame__title-group"><strong class="web-pane-frame__title" title="Lead terminal">Lead terminal</strong><small class="web-pane-frame__subtitle" title="Codex">Codex</small></span></div><span class="web-pane-frame__status" role="status" aria-label="Terminal is running" title="Terminal is running" data-item-kind="status" data-item-id="window.lead.status" data-chip-kind="domain" data-tone="info" data-busy="true"><i aria-hidden="true"></i><span>Running</span></span><div class="web-pane-frame__actions" role="toolbar" aria-label="Pane controls"></div></header><div class="web-pane-frame__body" data-body-sentinel="stable" id="pane-frame-body-window.lead" data-pane-body="window.lead" aria-label="terminal pane content"><div class="agent-pane__body" data-focus-zone="terminal"><div class="terminal-surface" data-phase="unavailable" data-focused="true" data-reduced-motion="false" data-preserves-frame="false"><div class="terminal-surface__viewport" aria-label="Lead terminal terminal"></div><div class="terminal-surface__state" aria-live="polite" role="status"><i aria-hidden="true"></i><strong>Native terminal unavailable</strong><span>The verified desktop terminal transport is not present in this build.</span></div></div></div></div></section></article></div>"`;

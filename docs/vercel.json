{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/(?:docs(?:/.*)?)?$",
      "continue": true,
      "transforms": [
        {
          "type": "response.headers",
          "op": "append",
          "target": { "key": "Vary" },
          "args": "Accept"
        }
      ]
    }
  ]
}

{
  "name": "@tmux-ide/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate": "node scripts/generate-ascii-wordmark.mjs && node scripts/generate-tui-mockup-motion.mjs && fumadocs-mdx",
    "build": "pnpm run generate && next build && pnpm run check:site",
    "check:performance": "node scripts/check-route-budget.mjs",
    "check:accessibility": "node scripts/check-accessibility.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:structure": "node scripts/check-marketing-structure.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:product-docs": "node scripts/check-product-docs.mjs",
    "check:site": "pnpm run check:structure && pnpm run check:seo && pnpm run check:accessibility && pnpm run check:motion && pnpm run check:performance && pnpm run check:product-docs",
    "dev": "pnpm run generate && next dev",
    "lint": "pnpm run typecheck",
    "start": "next start",
    "typecheck": "pnpm run generate && tsc --noEmit",
    "types:check": "pnpm run typecheck"
  },
  "dependencies": {
    "@takumi-rs/image-response": "^0.70.4",
    "@vercel/analytics": "^2.0.1",
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.4",
    "geist": "^1.7.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "matinee": "0.1.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  }
}

+/*
+ * Acknowledge a kitty graphics command when kitty-graphics is on, in stream
+ * order with other replies. The pane's bytes reach control clients unchanged,
+ * and they render the image; tmux only answers so that programs detect
+ * support. Responses follow the protocol: only for commands naming an image
+ * (i or I), after the last chunk, and suppressed by q.
+ */
+static void
+input_kitty_graphics(struct input_ctx *ictx, const u_char *buf, size_t len)
+{
+	struct window_pane	*wp = ictx->wp;
+	struct options		*oo = wp != NULL ? wp->options : global_w_options;
+	char			 a = 't', t = 'd', key, more = 0;
+	u_int			 i = 0, I = 0, p = 0, q = 0, value;
+	size_t			 at = 0;
+	char			 extra[64];
+
+	if (!options_get_number(oo, "kitty-graphics"))
+		return;
+	while (at < len && buf[at] != ';') {
+		key = buf[at];
+		if (at + 1 >= len || buf[at + 1] != '=')
+			return;
+		at += 2;
+		value = 0;
+		if (key == 'a' && at < len && buf[at] != ',' && buf[at] != ';')
+			a = buf[at++];
+		else if (key == 't' && at < len && buf[at] != ',' &&
+		    buf[at] != ';')
+			t = buf[at++];
+		while (at < len && buf[at] >= '0' && buf[at] <= '9' &&
+		    value < 100000000)
+			value = value * 10 + (buf[at++] - '0');
+		while (at < len && buf[at] != ',' && buf[at] != ';')
+			at++;
+		if (at < len && buf[at] == ',')
+			at++;
+		switch (key) {
+		case 'i': i = value; break;
+		case 'I': I = value; break;
+		case 'p': p = value; break;
+		case 'q': q = value; break;
+		case 'm': more = value != 0; break;
+		}
+	}
+	if (ictx->kitty_more) {
+		if (more)
+			return;
+		ictx->kitty_more = 0;
+		a = ictx->kitty_a;
+		t = ictx->kitty_t;
+		i = ictx->kitty_i;
+		I = ictx->kitty_I;
+		p = ictx->kitty_p;
+		q = ictx->kitty_q;
+	} else if ((a == 't' || a == 'T' || a == 'f') && more) {
+		ictx->kitty_more = 1;
+		ictx->kitty_a = a;
+		ictx->kitty_t = t;
+		ictx->kitty_i = i;
+		ictx->kitty_I = I;
+		ictx->kitty_p = p;
+		ictx->kitty_q = q;
+		return;
+	}
+	if (i == 0 && I == 0)
+		return;
+	if (a != 't' && a != 'T' && a != 'p' && a != 'q' && a != 'f')
+		return;
+	/*
+	 * Only direct (inline) data reaches the renderer through control mode;
+	 * refuse file and shared-memory media so clients fall back to it.
+	 */
+	if (t != 'd' && a != 'p') {
+		if (q >= 2)
+			return;
+	} else if (q >= 1)
+		return;
+	*extra = '\0';
+	if (I != 0 && i != 0)
+		xsnprintf(extra, sizeof extra, "i=%u,I=%u", i, I);
+	else if (I != 0)
+		xsnprintf(extra, sizeof extra, "I=%u", I);
+	else
+		xsnprintf(extra, sizeof extra, "i=%u", i);
+	if (t != 'd' && a != 'p')
+		input_reply(ictx, 1,
+		    "\033_G%s;EINVAL:transmission medium not supported\033\\",
+		    extra);
+	else if (p != 0 && a != 'q')
+		input_reply(ictx, 1, "\033_G%s,p=%u;OK\033\\", extra, p);
+	else
+		input_reply(ictx, 1, "\033_G%s;OK\033\\", extra);
+}

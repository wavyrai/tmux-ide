diff --git a/cmd-capture-pane.c b/cmd-capture-pane.c
index 8f537b9..ee91f05 100644
--- a/cmd-capture-pane.c
+++ b/cmd-capture-pane.c
@@ -42,7 +42,7 @@ const struct cmd_entry cmd_capture_pane_entry = {
 	.name = "capture-pane",
 	.alias = "capturep",
 
-	.args = { "ab:CeE:FHJLMNpPqS:Tt:", 0, 0, NULL },
+	.args = { "ab:CeE:FHJLMNpPqRS:Tt:V", 0, 0, NULL },
 	.usage = "[-aCeFHJLMNpPqT] " CMD_BUFFER_USAGE " [-E end-line] "
 		 "[-S start-line] " CMD_TARGET_PANE_USAGE,
 
@@ -175,6 +175,10 @@ cmd_capture_pane_history(struct args *args, struct cmdq_item *item,
 			return (xstrdup(""));
 		}
 		s = &wp->base;
+	} else if (args_has(args, 'V')) {
+		wme = TAILQ_FIRST(&wp->modes);
+		s = (wme != NULL && wme->screen != NULL) ? wme->screen : &wp->base;
+		gd = s->grid;
 	} else if (args_has(args, 'M')) {
 		wme = TAILQ_FIRST(&wp->modes);
 		if (wme != NULL && wme->mode->get_screen != NULL) {
@@ -229,6 +233,49 @@ cmd_capture_pane_history(struct args *args, struct cmdq_item *item,
 		top = tmp;
 	}
 
+
+	/* Read-only physical grid export for tmux-ide replica backing. */
+	if (args_has(args, 'R')) {
+		struct grid_cell cell;
+		u_int x, k;
+		char record[512], hex[sizeof cell.data.data * 2 + 1], attrs[128];
+
+		if (s == &wp->base) {
+			input_current_cell(wp->ictx, &cell);
+			snprintf(attrs, sizeof attrs, "[%u,%d,%d,%d]",
+			    cell.attr, cell.fg, cell.bg, cell.us);
+		} else
+			snprintf(attrs, sizeof attrs, "null");
+		n = snprintf(record, sizeof record,
+		    "{\"version\":2,\"cols\":%u,\"rows\":%u,"
+		    "\"history\":%u,\"hscrolled\":%u,\"limit\":%u,"
+		    "\"cursor\":[%u,%u],\"currentAttributes\":%s}\n",
+		    gd->sx, gd->sy, gd->hsize, gd->hscrolled, gd->hlimit,
+		    s->cx, s->cy, attrs);
+		buf = cmd_capture_pane_append(buf, len, record, n);
+		for (i = top; i <= bottom; i++) {
+			gl = grid_peek_line(gd, i);
+			n = snprintf(record, sizeof record,
+			    "{\"row\":%u,\"flags\":%d,\"used\":%u,\"cells\":[",
+			    i, gl->flags, gl->cellused);
+			buf = cmd_capture_pane_append(buf, len, record, n);
+			for (x = 0; x < gl->cellsize; x++) {
+				grid_get_cell(gd, x, i, &cell);
+				for (k = 0; k < cell.data.size; k++)
+					snprintf(hex + k * 2, 3, "%02x", cell.data.data[k]);
+				hex[cell.data.size * 2] = '\0';
+				n = snprintf(record, sizeof record,
+				    "%s[%d,%u,\"%s\",%u,%d,%d,%d,%u,%d]",
+				    x ? "," : "", cell.flags, cell.data.width, hex,
+				    cell.attr, cell.fg, cell.bg, cell.us, cell.link,
+				    gl->celldata[x].flags);
+				buf = cmd_capture_pane_append(buf, len, record, n);
+			}
+			buf = cmd_capture_pane_append(buf, len, "]}\n", 3);
+		}
+		return (buf);
+	}
+
 	join_lines = args_has(args, 'J');
 	if (args_has(args, 'e'))
 		flags |= GRID_STRING_WITH_SEQUENCES;
diff --git a/input.c b/input.c
index ae503e5..21980f1 100644
--- a/input.c
+++ b/input.c
@@ -150,6 +150,13 @@ struct input_ctx {
 /* Helper functions. */
 struct input_transition;
 static void	input_request_timer_callback(int, short, void *);
+/* Current rendition at the native capture seam; parser state remains private. */
+void
+input_current_cell(struct input_ctx *ictx, struct grid_cell *gc)
+{
+	memcpy(gc, ictx != NULL ? &ictx->cell.cell : &grid_default_cell, sizeof *gc);
+}
+
 static void	input_start_request_timer(struct input_ctx *);
 static struct input_request *input_make_request(struct input_ctx *,
 		    enum input_request_type);
diff --git a/tmux.h b/tmux.h
index 5dc86b2..c9f8a32 100644
--- a/tmux.h
+++ b/tmux.h
@@ -3163,6 +3163,7 @@ struct input_ctx *input_init(struct window_pane *, struct bufferevent *,
 	     struct colour_palette *, struct client *);
 void	 input_free(struct input_ctx *);
 void	 input_reset(struct input_ctx *, int);
+void	 input_current_cell(struct input_ctx *, struct grid_cell *);
 struct evbuffer *input_pending(struct input_ctx *);
 void	 input_parse_pane(struct window_pane *);
 void	 input_parse_buffer(struct window_pane *, const u_char *, size_t);

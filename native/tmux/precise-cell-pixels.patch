+
+/* winsize pixel dimensions are unsigned shorts; avoid overflow and wrapping. */
+u_int
+window_pixel_size(u_int milli, u_int cell, u_int cells)
+{
+	uint64_t pixels = milli == 0 ? (uint64_t)cell * cells :
+	    ((uint64_t)milli * cells + 500) / 1000;
+	return (pixels > USHRT_MAX ? USHRT_MAX : pixels);
+}

     }
 
+    // Experimental embedding ABI: caller owns the source stream and must
+    // serialize feed/free. Outgoing callback bytes are borrowed for this call.
+    export fn tmux_ide_ghostty_surface_new_external(
+        app: *App,
+        opts: *const Surface.Options,
+        userdata: ?*anyopaque,
+        write: *const fn (?*anyopaque, [*]const u8, usize) callconv(.c) void,
+    ) ?*Surface {
+        const surface = app.core_app.alloc.create(Surface) catch return null;
+        surface.initExternal(app, opts.*, .{ .userdata = userdata, .write = write }) catch |err| {
+            app.core_app.alloc.destroy(surface);
+            log.err("external surface init failed: {}", .{err});
+            return null;
+        };
+        return surface;
+    }
+
+    export fn tmux_ide_ghostty_surface_feed_output(surface: *Surface, bytes: [*]const u8, len: usize) void {
+        if (surface.external_io == null or len == 0) return;
+        surface.core_surface.io.processOutput(bytes[0..len]);
+    }
+
     export fn ghostty_surface_free(ptr: *Surface) void {
         ptr.app.closeSurface(ptr);
     }

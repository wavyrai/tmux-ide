+
+test "external backend emits input without a PTY and honors linefeed mode" {
+    const Collector = struct {
+        bytes: [32]u8 = undefined,
+        len: usize = 0,
+        fn write(raw: ?*anyopaque, bytes: [*]const u8, len: usize) callconv(.c) void {
+            const self: *@This() = @ptrCast(@alignCast(raw.?));
+            @memcpy(self.bytes[self.len .. self.len + len], bytes[0..len]);
+            self.len += len;
+        }
+    };
+    var output: Collector = .{};
+    var backend: Backend = .{ .external = .{ .userdata = &output, .write = Collector.write } };
+    defer backend.deinit();
+    try std.testing.expect(backend.getProcessInfo(.tty_name) == null);
+    try backend.queueWrite(std.testing.allocator, undefined, "a\rb", true);
+    try backend.queueWrite(std.testing.allocator, undefined, "c\rd", false);
+    try std.testing.expectEqualStrings("a\r\nbc\rd", output.bytes[0..output.len]);
+}

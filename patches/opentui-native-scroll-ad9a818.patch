+        opts.chunk_size = 32768;
+        opts.initial_chunks = if (fail_publication) 1 else 2;
+        opts.max_bytes = if (fail_publication) 32768 else 65536;
+        opts.growth_policy = @intFromEnum(native_span_feed.GrowthPolicy.block);
+        opts.auto_commit_on_full = 0;
+        const feed = try native_span_feed.Stream.create(std.testing.allocator, opts);
+        const r = try CliRenderer.createWithOptions(std.testing.allocator, 40, 20, pool, .{ .remote_mode = .remote, .output = .{ .feed = feed }, .clearOnShutdown = false });
+        defer feed.destroy();

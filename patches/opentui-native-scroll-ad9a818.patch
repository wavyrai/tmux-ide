+fn paintColorPair(r: *CliRenderer, fg_change: bool, bg_change: bool, attribute_change: bool, link_change: bool) void {
+    const attributes = ansi.TextAttributes.BOLD | ansi.TextAttributes.INVERSE;
+    for (0..2) |x| r.getNextBuffer().setRaw(@intCast(x), 0, .{
+        .char = if (x == 0) 'a' else 'b',
+        .fg = ansi.rgbColor(if (x == 1 and fg_change) 201 else 101, 102, 103, 255),
+        .bg = ansi.rgbColor(if (x == 1 and bg_change) 204 else 104, 105, 106, 255),
+        .attributes = if (x == 1 and attribute_change) 0 else if (x == 1 and link_change) ansi.TextAttributes.setLinkId(attributes, 1) else attributes,
+    });
+}

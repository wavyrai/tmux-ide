+        r.terminal.caps.declrmm = true;
+        paintRectFixture(r.getNextBuffer(), 0);
+        try std.testing.expectEqual(renderer.RenderStatus.rendered, r.render(true));
+        var spans: [128]native_span_feed.SpanInfo = undefined;
+        if (fail_publication) {
+            const count = feed.drainSpans(&spans);
+            for (spans[0..count]) |span| feed.markSpanConsumed(span);
+            const blocker = [_]u8{'x'} ** 32704;
+            try feed.writeAtomic(&blocker);
+        } else {

+// Called once during host initialization, before any renderer exists.
+export fn configureScrollPrototype(enabled: bool) void {
+    renderer.scrollPrototypeDefault = enabled;
+}
+
+export fn rendererBeginScrollPrototypeFrame(renderer_handle: NativeHandle, frame_id: u32) void {
+    const object_ptr = acquireRenderer(renderer_handle) orelse return;
+    object_ptr.beginScrollPrototypeFrame(frame_id);
+}
+
+export fn rendererScrollPrototypeMarginsSupported(renderer_handle: NativeHandle) bool {
+    const object_ptr = acquireRenderer(renderer_handle) orelse return false;
+    return object_ptr.terminal.caps.declrmm and object_ptr.terminal.multiplexer == .none;
+}
+
+// Private prototype geometry hint. Existing FFI structures and exports unchanged.
+export fn rendererQueueScrollPrototypeRect(renderer_handle: NativeHandle, x: u32, y: u32, width: u32, height: u32) bool {
+    const object_ptr = acquireRenderer(renderer_handle) orelse return false;
+    return object_ptr.queueScrollPrototypeRect(x, y, width, height);
+}
+
 export fn render(renderer_handle: NativeHandle, force: bool) u8 {
     const object_ptr = acquireRenderer(renderer_handle) orelse return @intFromEnum(renderer.RenderStatus.failed);
     return @intFromEnum(object_ptr.render(force));

{
  "version": 1,
  "referenceHost": "Apple silicon macOS reference runner",
  "referenceLatency": {
    "localInputToPaintP95Ms": 16.67,
    "comparison": "less-than-or-equal",
    "clockRule": "input and paint endpoints must share one client monotonic clock"
  },
  "portableInvariants": {
    "clientCounts": [2, 4, 8],
    "oneControlConnectionPerSession": true,
    "convergenceIdentity": ["generation", "incarnation", "revision", "stateHash"],
    "boundedClientQueues": true,
    "slowClientIsolation": true,
    "terminalMutationOutcomes": ["observed", "rejected", "timed-out"],
    "idlePollingOrGridWalks": 0
  }
}

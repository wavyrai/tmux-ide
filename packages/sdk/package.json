{
  "name": "@tmux-ide/sdk",
  "version": "0.1.0",
  "description": "Typed, host-neutral client SDK for tmux-ide",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wavyrai/tmux-ide.git",
    "directory": "packages/sdk"
  },
  "exports": {
    ".": "./src/index.ts"
  },

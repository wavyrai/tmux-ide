+pub fn dirtyClear(state_: RenderState) callconv(lib.calling_conv) Result {
+    const state = state_ orelse return .invalid_value;
+    state.state.dirty = .false;
+    @memset(state.state.row_data.items(.dirty), false);
+    return .success;
+}

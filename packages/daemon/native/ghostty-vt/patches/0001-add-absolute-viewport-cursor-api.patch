+/// Set the active-screen cursor to an absolute viewport position.
+///
+/// This intentionally bypasses origin mode and scrolling margins. It is for
+/// synchronizing an authoritative cursor supplied alongside a terminal byte
+/// stream, not for implementing a VT cursor-positioning sequence. Saved cursor
+/// state, modes, and scrolling margins are left untouched.
+pub fn cursor_set_absolute(
+    terminal_: Terminal,
+    x: size.CellCountInt,
+    y: size.CellCountInt,
+) callconv(lib.calling_conv) Result {
+    const t: *ZigTerminal = (terminal_ orelse return .invalid_value).terminal;
+    if (x >= t.cols or y >= t.rows) return .invalid_value;
+
+    const screen = t.screens.active;
+    screen.cursorMarkDirty();
+    screen.cursorAbsolute(x, y);
+    screen.cursor.pending_wrap = false;
+    screen.cursorMarkDirty();
+    return .success;
+}

+/**
+ * Set the active-screen cursor to an absolute viewport position.
+ *
+ * This bypasses origin mode and scrolling margins. It is intended for
+ * synchronizing an authoritative cursor supplied alongside a terminal byte
+ * stream, not for implementing a VT cursor-positioning sequence. Pending wrap
+ * is cleared. Saved cursor state, modes, and scrolling margins are unchanged.
+ *
+ * @param terminal The terminal handle (NULL returns GHOSTTY_INVALID_VALUE)
+ * @param x Zero-based absolute viewport column (must be within bounds)
+ * @param y Zero-based absolute viewport row (must be within bounds)
+ * @return GHOSTTY_SUCCESS on success, or GHOSTTY_INVALID_VALUE
+ *
+ * @ingroup terminal
+ */
+GHOSTTY_API GhosttyResult ghostty_terminal_cursor_set_absolute(GhosttyTerminal terminal,
+                                                    uint16_t x,
+                                                    uint16_t y);
